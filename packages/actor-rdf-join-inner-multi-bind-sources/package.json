{
  "name": "@comunica/actor-rdf-join-inner-multi-bind-sources",
  "version": "5.3.0",
  "description": "An RDF join actor that pushes blocks of bindings into the sources of another entry, also when it spans several sources",
  "lsd:module": true,
  "license": "MIT",
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/comunica-association"
  },
  "homepage": "https://comunica.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/ecrum19/comunica-feature-cottas.git",
    "directory": "packages/actor-rdf-join-inner-multi-bind-sources"
  },
  "bugs": {
    "url": "https://github.com/ecrum19/comunica-feature-cottas/issues"
  },
  "keywords": [
    "comunica",
    "actor",
    "rdf-join",
    "inner",
    "bind",
    "federation"
  ],
  "sideEffects": false,
  "main": "lib/index.js",
  "typings": "lib/index",
  "publishConfig": {
