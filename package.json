{
  "private": true,
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "repository": "https://github.com/ecrum19/comunica-feature-cottas/",
  "workspaces": [
    "engines/*",
    "packages/*",
    "performance/*"
  ],
  "scripts": {
    "test-changed": "lerna run test --since HEAD",
    "build-changed": "lerna run build --since HEAD",
    "test": "jest",
    "test-ci": "jest --ci --maxWorkers=4 --coverage",
    "verify": "yarn run build && yarn run test-ci && yarn run lint && yarn run depcheck && yarn run test-performance && yarn run doc",
    "lint": "eslint . --cache",
    "clean": "rm -rf ./node_modules && rm -rf ./packages/*/node_modules",
    "depcheck": "depcheckTask @comunica/config-query-sparql-cottas",
    "ncu:all": "lerna-script updateTask",
    "ncu:major:all": "lerna-script updateTaskMajor",
    "build": "npm run build:ts && npm run build:components",
    "build:ts": "tsc",
    "build:components": "componentsjs-generator engines/* packages/*",
    "build-watch": "nodemon -e ts --ignore '*.d.ts' --exec yarn run build",
    "build-watch:ts": "tsc --watch",
    "build-watch:components": "nodemon -e d.ts --exec yarn run build:components",
    "publish": "yarn run build",
    "publish-release": "lerna publish",
    "publish-bare": "lerna exec -- npm publish --silent",
    "publish-canary": "yarn run build && lerna version prerelease --preid alpha.$(node_modules/@comunica/utils-monorepo/sh/get-next-alpha-version.sh @comunica/query-sparql-cottas) --exact --ignore-scripts --force-publish --no-push --no-git-tag-version --yes && git update-index --assume-unchanged $(git ls-files | tr '\\n' ' ') && lerna publish from-package --no-git-reset --pre-dist-tag next --force-publish --no-push --no-git-tag-version --yes && git update-index --no-assume-unchanged $(git ls-files | tr '\\n' ' ') && git checkout .",
    "doc": "node_modules/@comunica/utils-monorepo/sh/typedoc-json.sh create && typedoc && node_modules/@comunica/utils-monorepo/sh/typedoc-json.sh remove",
    "postinstall": "yarn run build && lerna run prepare",
    "version": "manual-git-changelog onversion",
    "test-performance": "node --test performance/tests/*.test.js && yarn workspace benchmark-bsbm-cottas validate && yarn workspace benchmark-bsbm-cottas-10k validate && yarn workspace benchmark-watdiv-cottas validate && yarn workspace benchmark-watdiv-cottas-100 validate"
  },
  "devDependencies": {
    "@babel/core": "^8.0.0",
    "@babel/preset-env": "^8.0.0",
    "@comunica/packager": "^5.0.0",
    "@comunica/utils-jest": "^5.3.0",
    "@comunica/utils-monorepo": "^5.3.0",
    "@rubensworks/eslint-config": "^3.0.0",
    "@rubensworks/process-sparql-benchmark-results": "^1.3.4",
    "@types/jest": "^30.0.0",
    "@types/n3": "^1.26.1",
    "@types/node": "^24.0.0",
    "asynciterator": "^3.10.0",
    "babel-loader": "^10.0.0",
    "componentsjs-generator": "^4.2.0",
    "cross-fetch": "^4.0.0",
    "eslint": "^8.57.0",
    "immutable": "^5.0.0",
    "jest": "^30.0.0",
    "jest-rdf": "^2.0.0",
    "lerna": "^10.0.0",
    "manual-git-changelog": "^1.0.0",
    "nodemon": "^3.0.0",
    "npm-check-updates": "^23.0.0",
    "pre-commit": "^2.0.0",
    "rdf-data-factory": "^2.0.2",
    "rdf-quad": "^2.0.0",
    "rdf-test-suite-ldf": "^2.0.1",
    "sparql-benchmark-runner": "^5.1.0",
    "stream-to-string": "^1.1.0",
    "streamify-array": "^2.0.0",
    "streamify-string": "^1.0.1",
    "ts-jest": "^29.4.6",
    "typedoc": "^0.28.0",
    "typescript": "^5.9.3",
    "webpack": "^5.64.4",
    "webpack-cli": "^7.0.0"
  },
  "pre-commit": [
    "build",
    "lint",
    "test"
  ],
  "resolutions": {
    "**/sparql-benchmark-runner/fetch-sparql-endpoint": "7.1.1",
    "rdf-parse": "5.0.0"
  }
}
